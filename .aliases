# shell
alias szsh="source ~/.zshrc"

# vim
alias v="nvim"
alias vim="nvim"

# dot files
alias dots='git --git-dir=$HOME/.dotfiles/ --work-tree=$HOME'
alias dots_qs="dots add -u && dots commit -m 'hi' && dots push"

# terraform
alias tf="terraform"

# chrome
if [[ "$OSTYPE" == darwin* ]]; then
  alias chrome="/Applications/Google\ Chrome.app/Contents/MacOS/Google\ Chrome"
else
  alias chrome="google-chrome-stable"
fi

source $HOME/scripts/git_aliases.sh
source $HOME/scripts/uv_aliases.sh
source $HOME/scripts/python_aliases.sh

# venv
alias qvenv="source .venv/bin/activate"
alias pip="uv pip"

# runpod
alias rp="runpodctl"

# desktop: Eternal Terminal (auto-reconnects) straight into a persistent tmux session
alias dt='et desktop -c "tmux new -A -s main"'
